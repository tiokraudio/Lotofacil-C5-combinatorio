{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:c5": "tsx src/c5/tests/runner.ts",
    "test:c5:unit": "tsx src/c5/tests/unit.test.ts",
    "test:c5:scorer": "tsx src/c5/tests/scorer.test.ts",
    "test:c5:record": "tsx src/c5/tests/record.test.ts",
    "test:c5:integrity": "tsx src/c5/tests/integrity.test.ts",
    "test:c5:storage": "tsx src/storage/tests/storage.test.ts",
    "test:c5:import": "tsx src/storage/tests/import.test.ts",
    "test:c5:quarantine": "tsx src/storage/tests/quarantine.test.ts",
    "test:c5:concurrency": "tsx src/storage/tests/concurrency.test.ts",
    "test:c5:golden": "tsx src/c5/tests/golden.test.ts",
    "test:lottery": "tsx src/lottery/tests/validator.test.ts && tsx src/lottery/tests/integration.test.ts",
    "test:lottery:live": "tsx src/lottery/tests/caixaLiveCertification.ts",
    "test:contest-lifecycle": "tsx src/sync/tests/contestLifecycle.test.ts",
    "test:sync": "tsx src/sync/tests/sync.test.ts && tsx src/sync/tests/primaryAction.test.ts && tsx src/sync/tests/contestLifecycle.test.ts",
    "test:manifest": "tsx src/system/tests/manifest.test.ts",
    "test:c5:massive": "tsx src/c5/tests/massive.test.ts",
    "test:c5:sanity": "tsx src/c5/tests/randomSanity.test.ts",
    "test:c5:exhaustive": "tsx src/c5/tests/exhaustive.test.ts",
    "test:ui": "tsx src/tests/ui.test.ts",
    "test:e2e": "tsx src/tests/e2eCertification.test.ts",
    "test:operational": "tsx src/tests/operationalRobustness.test.ts",
    "test:operational-robustness": "tsx src/tests/operationalRobustness.test.ts",
    "test:multitab": "tsx src/tests/multiTabSync.test.ts",
    "test:bet-management": "tsx src/tests/betManagement.test.ts",
    "test:prize-management": "tsx src/tests/prizeManagement.test.ts",
    "test:financial": "npm run test:prize-management",
    "test": "npm run test:manifest && npm run test:c5:unit && npm run test:c5:golden && npm run test:c5:scorer && npm run test:c5:record && npm run test:c5:integrity && npm run test:c5:storage && npm run test:c5:import && npm run test:c5:quarantine && npm run test:c5:concurrency && npm run test:lottery && npm run test:sync && npm run test:contest-lifecycle && npm run test:ui && npm run test:operational-robustness && npm run test:e2e && npm run test:multitab && npm run test:bet-management && npm run test:prize-management"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
